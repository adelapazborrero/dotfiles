// Zed keymap — translated from VSCode keybindings.json + Vim extension mappings
//
// Docs: https://zed.dev/docs/key-bindings
// Inspect the active context at a cursor with the command palette:
//   "dev: open key context view"
[
  // Workspace-level navigation (works whether the editor or a panel is focused)
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-shift-p": "command_palette::Toggle", // showCommands
      "ctrl-i": "terminal_panel::ToggleFocus", // new / toggle terminal
      "ctrl-p": ["pane::CloseActiveItem", { "close_pinned": false }], // closeActiveEditor
      "ctrl-h": "pane::ActivatePreviousItem", // previousEditor
      "ctrl-l": "pane::ActivateNextItem", // nextEditor
      "ctrl-n": "project_panel::ToggleFocus", // toggle file explorer
      "ctrl-shift-o": "projects::OpenRecent", // openRecent
    },
  },

  // Same nav bindings inside the editor, so they win over vim defaults while typing
  {
    "context": "Editor",
    "bindings": {
      "ctrl-shift-p": "command_palette::Toggle", // beats default editor::SelectUp
      "ctrl-i": "terminal_panel::ToggleFocus", // beats vim jumplist (ctrl-i == tab)
      "ctrl-p": ["pane::CloseActiveItem", { "close_pinned": false }],
      "ctrl-h": "pane::ActivatePreviousItem",
      "ctrl-l": "pane::ActivateNextItem",
      "ctrl-n": "project_panel::ToggleFocus",
      "ctrl-j": "editor::AcceptEditPrediction", // inlineSuggest.commit
    },
  },

  // ctrl-i while the terminal is focused hides the panel and returns to the editor
  {
    "context": "Terminal",
    "bindings": {
      "ctrl-i": "terminal_panel::Toggle",
    },
  },

  // ctrl-n while the file tree is focused hides it and returns to the editor
  {
    "context": "ProjectPanel",
    "bindings": {
      "ctrl-n": "project_panel::Toggle",
    },
  },

  // Vim normal-mode mappings (translated from vim.normalModeKeyBindings)
  {
    "context": "vim_mode == normal",
    "bindings": {
      "ctrl-shift-p": "command_palette::Toggle", // beats vim jumplist / SelectUp
      "ctrl-i": "terminal_panel::ToggleFocus", // beats vim jumplist forward
      "; f": "file_finder::Toggle", // quickOpen
      "; r": "pane::DeploySearch", // findInFiles
      "; g": "git::Diff", // git.openChange
      "f o": "editor::FindAllReferences", // findReferences
      "f f": "editor::Hover", // showHover
      "ctrl-k": "editor::Hover", // showDefinitionPreviewHover
      // "ctrl-k": "editor::GoToDefinition",               // peekDefinition (no peek in Zed)
      "; s": ["workspace::MoveItemToPaneInDirection", { "direction": "right" }], // moveEditorToNextGroup
      "w h": "workspace::ActivatePaneLeft", // focusLeftGroup
      "w l": "workspace::ActivatePaneRight", // focusRightGroup
      "[ g": "editor::GoToDiagnostic", // marker.next
      "r n": "editor::SelectAllMatches", // changeAll
    },
  },
]
